# Solo se versiona el código del ETL y los notebooks:
# se ignora todo lo de la raíz salvo lo que se reincluye con "!"
/*
!/.gitignore
!/ETL/
!/notebooks/
!/TP2/
!/TP3/

# Dentro de ETL, solo los scripts
/ETL/*
!/ETL/*.py

# Dentro de TP2, solo los notebooks
/TP2/*
!/TP2/notebooks/

# Dentro de TP3, solo los notebooks
/TP3/*
!/TP3/notebooks/

# Archivos generados por Python y Jupyter
__pycache__/
.ipynb_checkpoints/
