# Solo se versiona el código del ETL y los notebooks:
# se ignora todo lo de la raíz salvo lo que se reincluye con "!"
/*
!/.gitignore
!/ETL/
!/notebooks/
!/TP2/
!/TP3/

# Dentro de ETL, solo los scripts
/ETL/*
!/ETL/*.py

# Dentro de TP2, solo los notebooks
/TP2/*
!/TP2/notebooks/

# Dentro de TP3, solo los notebooks
/TP3/*
!/TP3/notebooks/

# Archivos generados por Python y Jupyter
__pycache__/
.ipynb_checkpoints/

# Dentro de TP3/dashboard, solo el codigo (los parquet/json los regenera precomputo.py)
!/TP3/dashboard/
/TP3/dashboard/*
!/TP3/dashboard/*.py
!/TP3/dashboard/.streamlit/
!/TP3/dashboard/requirements*.txt

# Excepcion a "/TP3/*": los 3,5 MB que precomputo.py deja en TP3/data/processed/dashboard/.
# Sin esto el tablero no lo puede abrir un tercero que clone el repo: precomputo.py necesita
# el .joblib del Random Forest (1,1 GB, fuera de git). app.py solo lee estos archivos.
# Hay que reabrir cada nivel de directorio, porque "/TP3/*" ya excluyo TP3/data.
!/TP3/data/
/TP3/data/*
!/TP3/data/processed/
/TP3/data/processed/*
!/TP3/data/processed/dashboard/

# Documentacion de decisiones: los .md de cada TP (planes, pendientes, auditorias,
# historial de hallazgos). Aportan el contexto de por que el pipeline es como es.
!/TP2/*.md
!/TP3/*.md
!/*.md
